{
  "name": "meridian-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.e2e.json",
    "e2e": "playwright test",
    "screenshots": "SCREENSHOTS_DIR=../docs/screenshots playwright test screenshots",
    "screenshots:monitoring": "SCREENSHOTS_DIR=../docs/screenshots MONITORING=1 playwright test monitoring-screenshots",
    "screenshots:portfolio": "SCREENSHOTS_DIR=../docs/screenshots PORTFOLIO=1 playwright test portfolio-shots"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
